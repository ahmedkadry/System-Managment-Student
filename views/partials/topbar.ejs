<% var _u=null; if (typeof user !=='undefined' ) { _u=user; } var _role='' ; if (_u && _u.role) { _role=_u.role; } var
    _email='' ; if (_u && _u.email) { _email=_u.email; } var _initial='U' ; if (_email) { _initial=_email.substring(0,
    1).toUpperCase(); } var _t='Dashboard' ; if (typeof title !=='undefined' && title) { _t=title.split('|')[0].trim();
    } %>
    <header class="h-20 bg-brand-slate border-b border-gray-800 flex items-center justify-between px-6 flex-shrink-0">
        <div class="flex items-center gap-4">
            <button onclick="openSidebar()"
                class="md:hidden p-2 text-gray-400 hover:text-white bg-brand-navy rounded-lg border border-gray-700"
                aria-label="Open menu">
                <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
            <h1 class="text-xl font-semibold text-white">
                <%= _t %>
            </h1>
        </div>
        <div class="flex items-center gap-4">
            <button class="p-2 text-gray-400 hover:text-white bg-brand-navy rounded-full border border-gray-700">
                <i data-lucide="bell" class="w-5 h-5"></i>
            </button>
            <div class="flex items-center gap-3 border-l border-gray-700 pl-4">
                <div class="text-right hidden sm:block">
                    <p class="text-sm font-medium text-white">
                        <%= _email %>
                    </p>
                    <p class="text-xs text-brand-cyan">
                        <%= _role %>
                    </p>
                </div>
                <div
                    class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-violet to-brand-cyan flex items-center justify-center text-white font-bold">
                    <%= _initial %>
                </div>
            </div>
        </div>
    </header>