<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { brand: { navy: '#0B0F19', violet: '#8B5CF6', cyan: '#06B6D4' } } } }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: Inter, sans-serif;
        }
    </style>
</head>

<body class="bg-brand-navy min-h-screen flex items-center justify-center p-4">
    <div class="text-center max-w-2xl w-full">
        <h1 class="text-8xl font-bold text-red-500">500</h1>
        <p class="text-gray-300 mt-4 mb-6">
            <%= message %>
        </p>
        <% if (stack) { %>
            <pre
                class="text-left text-xs text-gray-500 bg-brand-slate p-4 rounded-lg overflow-x-auto max-h-64 border border-gray-800"><%= stack %></pre>
            <% } %>
                <div class="mt-8 flex gap-3 justify-center">
                    <a href="/dashboard"
                        class="bg-brand-violet hover:bg-violet-600 text-white px-6 py-2.5 rounded-lg font-medium">Dashboard</a>
                    <a href="javascript:history.back()"
                        class="bg-gray-800 hover:bg-gray-700 text-white px-6 py-2.5 rounded-lg font-medium border border-gray-700">Back</a>
                </div>
    </div>
</body>

</html>