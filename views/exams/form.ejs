<div class="mb-6">
    <a href="/exams" class="text-gray-400 hover:text-white flex items-center gap-2 text-sm mb-2">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
    </a>
    <h2 class="text-2xl font-bold text-white">
        <%= exam ? 'Edit Exam' : 'Create Exam' %>
    </h2>
</div>

<div class="bg-brand-slate rounded-2xl border border-gray-800 p-6 md:p-8 max-w-2xl">
    <form action="<%= action %>" method="POST" class="space-y-5">

        <div>
            <label class="block text-sm text-gray-300 mb-1">Course *</label>
            <select name="course_id" required
                class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
                <option value="">Select course</option>
                <% for (const c of courses) { %>
                    <option value="<%= c.id %>" <%=exam && exam.course_id===c.id ? 'selected' : '' %>><%= c.course_code
                            %> — <%= c.name %>
                    </option>
                    <% } %>
            </select>
        </div>

        <div>
            <label class="block text-sm text-gray-300 mb-1">Exam Title *</label>
            <input type="text" name="title" required maxlength="100" value="<%= exam ? exam.title : '' %>"
                class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet"
                placeholder="e.g. Midterm Exam">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm text-gray-300 mb-1">Date *</label>
                <input type="date" name="exam_date" required
                    value="<%= exam ? new Date(exam.exam_date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet [color-scheme:dark]">
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Max Marks *</label>
                <input type="number" name="max_marks" required min="1" max="1000"
                    value="<%= exam ? exam.max_marks : 100 %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
            <div>
                <label class="block text-sm text-gray-300 mb-1">Passing Marks *</label>
                <input type="number" name="passing_marks" required min="0" max="1000"
                    value="<%= exam ? exam.passing_marks : 50 %>"
                    class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
            </div>
        </div>

        <div class="flex justify-end gap-4 border-t border-gray-800 pt-6">
            <a href="/exams" class="px-6 py-2.5 rounded-lg text-gray-300 hover:bg-gray-800">Cancel</a>
            <button type="submit"
                class="bg-brand-violet hover:bg-violet-600 text-white px-6 py-2.5 rounded-lg font-medium shadow-glow-violet">
                <%= exam ? 'Update Exam' : 'Create Exam' %>
            </button>
        </div>
    </form>
</div>