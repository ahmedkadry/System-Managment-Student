<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-white">Exams & Assessments</h2>
        <p class="text-gray-400 text-sm">Create exams and record student marks</p>
    </div>
    <a href="/exams/create"
        class="bg-brand-violet hover:bg-violet-600 text-white px-4 py-2 rounded-lg font-medium flex items-center gap-2 shadow-glow-violet">
        <i data-lucide="plus" class="w-4 h-4"></i> Create Exam
    </a>
</div>

<!-- Course selector -->
<div class="bg-brand-slate rounded-2xl border border-gray-800 p-5 mb-6">
    <form action="/exams" method="GET" class="flex gap-3 items-end flex-wrap">
        <div class="flex-1 min-w-64">
            <label class="block text-sm text-gray-300 mb-1">Filter by course</label>
            <select name="course"
                class="w-full bg-brand-navy border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-brand-violet">
                <option value="">All Courses</option>
                <% for (const c of courses) { %>
                    <option value="<%= c.id %>" <%=String(selectedCourseId)===String(c.id) ? 'selected' : '' %>><%=
                            c.course_code %> — <%= c.name %>
                    </option>
                    <% } %>
            </select>
        </div>
        <button type="submit"
            class="bg-gray-700 hover:bg-gray-600 text-white px-5 py-2.5 rounded-lg text-sm">Filter</button>
    </form>
</div>

<% if (exams.length===0) { %>
    <div class="bg-brand-slate rounded-2xl border border-gray-800 p-10 text-center">
        <i data-lucide="clipboard-list" class="w-12 h-12 mx-auto text-gray-600 mb-3"></i>
        <p class="text-gray-400">No exams found.</p>
        <a href="/exams/create" class="inline-block mt-4 text-brand-violet hover:underline">Create the first exam →</a>
    </div>
    <% } else { %>
        <div class="bg-brand-slate rounded-2xl border border-gray-800 overflow-hidden">
            <table class="w-full text-left text-sm text-gray-400">
                <thead class="text-xs uppercase bg-brand-navy/50 border-b border-gray-800">
                    <tr>
                        <th class="px-6 py-4">Exam</th>
                        <th class="px-6 py-4">Course</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Max / Pass</th>
                        <th class="px-6 py-4">Graded</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    <% for (const e of exams) { %>
                        <tr class="hover:bg-brand-navy/30">
                            <td class="px-6 py-4 font-medium text-white">
                                <%= e.title %>
                            </td>
                            <td class="px-6 py-4">
                                <%= selectedCourse ? selectedCourse.course_code : '—' %>
                            </td>
                            <td class="px-6 py-4">
                                <%= new Date(e.exam_date).toLocaleDateString() %>
                            </td>
                            <td class="px-6 py-4">
                                <%= e.max_marks %> / <%= e.passing_marks %>
                            </td>
                            <td class="px-6 py-4">
                                <span
                                    class="px-2.5 py-1 rounded-full bg-brand-violet/10 text-brand-violet text-xs font-medium">
                                    <%= e.graded_count %> students
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/exams/<%= e.id %>/grades"
                                    class="text-brand-cyan hover:underline text-xs mr-3 font-medium">Enter Grades</a>
                                <a href="/exams/edit/<%= e.id %>" class="text-gray-400 hover:text-brand-violet mr-3"
                                    title="Edit">
                                    <i data-lucide="edit" class="w-4 h-4 inline"></i>
                                </a>
                                <button onclick="confirmDelete(<%= e.id %>)" class="text-gray-400 hover:text-red-500"
                                    title="Delete">
                                    <i data-lucide="trash-2" class="w-4 h-4 inline"></i>
                                </button>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>
        <% } %>

            <script>
                function confirmDelete(id) {
                    Swal.fire({
                        title: 'Delete exam?',
                        text: 'All grades recorded for this exam will be removed.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#EF4444',
                        cancelButtonColor: '#334155',
                        confirmButtonText: 'Yes, delete',
                        background: '#1E293B',
                        color: '#F8FAFC'
                    }).then(function (r) {
                        if (r.isConfirmed) window.location.href = '/exams/delete/' + id;
                    });
                }
            </script>