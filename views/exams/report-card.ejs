<div class="mb-6">
    <a href="/students/edit/<%= student.id %>"
        class="text-gray-400 hover:text-white flex items-center gap-2 text-sm mb-2">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Student
    </a>
    <h2 class="text-2xl font-bold text-white">Report Card</h2>
</div>

<!-- Student Header -->
<div class="bg-brand-slate rounded-2xl border border-gray-800 p-6 mb-6">
    <div class="flex items-center gap-4">
        <img src="<%= studentAvatar %>" class="w-16 h-16 rounded-full object-cover border-2 border-brand-violet" alt="">
        <div class="flex-1">
            <h3 class="text-xl font-bold text-white">
                <%= student.first_name %>
                    <%= student.last_name %>
            </h3>
            <p class="text-sm text-brand-cyan font-mono">
                <%= student.student_id_code %>
            </p>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-500">Average Score</p>
            <p class="text-3xl font-bold text-white">
                <%= average %>%
            </p>
            <p class="text-xs text-gray-500 mt-1">
                <%= totalExams %> exam(s) recorded
            </p>
        </div>
    </div>
</div>

<% if (rows.length===0) { %>
    <div class="bg-brand-slate rounded-2xl border border-gray-800 p-10 text-center">
        <i data-lucide="clipboard-x" class="w-12 h-12 mx-auto text-gray-600 mb-3"></i>
        <p class="text-gray-400">No grades recorded yet.</p>
    </div>
    <% } else { %>
        <div class="bg-brand-slate rounded-2xl border border-gray-800 overflow-hidden">
            <table class="w-full text-left text-sm text-gray-400">
                <thead class="text-xs uppercase bg-brand-navy/50 border-b border-gray-800">
                    <tr>
                        <th class="px-6 py-4">Course</th>
                        <th class="px-6 py-4">Exam</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4 text-center">Marks</th>
                        <th class="px-6 py-4 text-center">%</th>
                        <th class="px-6 py-4 text-center">Grade</th>
                        <th class="px-6 py-4 text-center">Result</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    <% for (const r of rows) { %>
                        <tr class="hover:bg-brand-navy/30">
                            <td class="px-6 py-4">
                                <div class="text-white font-medium">
                                    <%= r.course %>
                                </div>
                                <div class="text-xs text-brand-cyan font-mono">
                                    <%= r.code %>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <%= r.title %>
                            </td>
                            <td class="px-6 py-4">
                                <%= r.date %>
                            </td>
                            <td class="px-6 py-4 text-center text-white">
                                <%= r.marks %> / <%= r.max_marks %>
                            </td>
                            <td class="px-6 py-4 text-center text-white">
                                <%= r.pctStr %>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= r.letterClass %>">
                                    <%= r.letter %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= r.resultClass %>">
                                    <%= r.result %>
                                </span>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>
        </div>
        <% } %>