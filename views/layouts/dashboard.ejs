<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: { extend: { colors: { brand: { navy: '#0B0F19', slate: '#1E293B', violet: '#8B5CF6', cyan: '#06B6D4' } } } }
        }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body
    class="bg-brand-navy text-gray-300 antialiased flex h-screen overflow-hidden selection:bg-brand-violet selection:text-white">

    <!-- Global loader -->
    <%- include('../partials/loader') %>

        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

            <!-- Main Content Column -->
            <div class="flex-1 flex flex-col h-screen overflow-hidden min-w-0">
                <!-- Topbar -->
                <%- include('../partials/topbar') %>

                    <!-- Page Content -->
                    <main class="flex-1 overflow-x-hidden overflow-y-auto bg-brand-navy p-4 md:p-6">
                        <%- typeof body !=='undefined' ? body : '<p class="text-gray-500">No content</p>' %>
                    </main>
            </div>

            <!-- Loader scripts -->
            <%- include('../partials/loader-scripts') %>

                <!-- Global scripts -->
                <script>
                    if (window.lucide) lucide.createIcons();
                    /* ... flash toasts ... */
                </script>

                <%- typeof script !=='undefined' ? script : '' %>
</body>

</html>