<div class="mb-6">
    <h2 class="text-2xl font-bold text-white">Reports</h2>
    <p class="text-gray-400 text-sm">Generate and export school data</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

    <a href="/reports/students"
        class="bg-brand-slate p-6 rounded-2xl border border-gray-800 hover:border-brand-violet transition-all group">
        <div
            class="w-12 h-12 rounded-xl bg-brand-violet/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <i data-lucide="users" class="text-brand-violet w-6 h-6"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">Student Directory</h3>
        <p class="text-sm text-gray-400">Full list of students with filters and CSV export</p>
    </a>

    <a href="/reports/attendance"
        class="bg-brand-slate p-6 rounded-2xl border border-gray-800 hover:border-brand-cyan transition-all group">
        <div
            class="w-12 h-12 rounded-xl bg-brand-cyan/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <i data-lucide="calendar-check" class="text-brand-cyan w-6 h-6"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">Attendance Summary</h3>
        <p class="text-sm text-gray-400">Per-student attendance rates and breakdown</p>
    </a>

    <a href="/reports/grades"
        class="bg-brand-slate p-6 rounded-2xl border border-gray-800 hover:border-purple-500 transition-all group">
        <div
            class="w-12 h-12 rounded-xl bg-purple-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <i data-lucide="bar-chart-2" class="text-purple-400 w-6 h-6"></i>
        </div>
        <h3 class="text-lg font-semibold text-white mb-1">Grade Report</h3>
        <p class="text-sm text-gray-400">Average scores per student per course</p>
    </a>
</div>