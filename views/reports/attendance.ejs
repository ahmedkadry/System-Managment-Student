<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
        <a href="/reports" class="text-gray-400 hover:text-white flex items-center gap-2 text-sm mb-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Reports
        </a>
        <h2 class="text-2xl font-bold text-white">Attendance Summary</h2>
    </div>
    <div class="flex gap-2">
        <a href="/reports/export/attendance"
            class="bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2">
            <i data-lucide="download" class="w-4 h-4"></i> Export CSV
        </a>
        <button onclick="window.print()"
            class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2">
            <i data-lucide="printer" class="w-4 h-4"></i> Print
        </button>
    </div>
</div>

<div class="bg-brand-slate rounded-2xl border border-gray-800 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-400">
            <thead class="text-xs uppercase bg-brand-navy/50 border-b border-gray-800">
                <tr>
                    <th class="px-4 py-3">ID</th>
                    <th class="px-4 py-3">Student</th>
                    <th class="px-4 py-3 text-center">Total</th>
                    <th class="px-4 py-3 text-center text-green-400">Present</th>
                    <th class="px-4 py-3 text-center text-red-400">Absent</th>
                    <th class="px-4 py-3 text-center text-yellow-400">Late</th>
                    <th class="px-4 py-3 text-center text-blue-400">Excused</th>
                    <th class="px-4 py-3 text-center">Rate</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
                <% if (rows.length===0) { %>
                    <tr>
                        <td colspan="8" class="px-4 py-8 text-center text-gray-500">No students found.</td>
                    </tr>
                    <% } else { %>
                        <% for (const r of rows) { %>
                            <tr class="hover:bg-brand-navy/30">
                                <td class="px-4 py-3 font-mono text-brand-cyan text-xs">
                                    <%= r.code %>
                                </td>
                                <td class="px-4 py-3 text-white">
                                    <%= r.name %>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <%= r.total %>
                                </td>
                                <td class="px-4 py-3 text-center text-green-400">
                                    <%= r.present %>
                                </td>
                                <td class="px-4 py-3 text-center text-red-400">
                                    <%= r.absent %>
                                </td>
                                <td class="px-4 py-3 text-center text-yellow-400">
                                    <%= r.late %>
                                </td>
                                <td class="px-4 py-3 text-center text-blue-400">
                                    <%= r.excused %>
                                </td>
                                <td class="px-4 py-3 text-center font-bold <%= r.rateClass %>">
                                    <%= r.rate %>
                                </td>
                            </tr>
                            <% } %>
                                <% } %>
            </tbody>
        </table>
    </div>
</div>