<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
        <a href="/reports" class="text-gray-400 hover:text-white flex items-center gap-2 text-sm mb-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Reports
        </a>
        <h2 class="text-2xl font-bold text-white">Grade Performance</h2>
    </div>
    <div class="flex gap-2">
        <a href="/reports/export/grades"
            class="bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2">
            <i data-lucide="download" class="w-4 h-4"></i> Export CSV
        </a>
        <button onclick="window.print()"
            class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2">
            <i data-lucide="printer" class="w-4 h-4"></i> Print
        </button>
    </div>
</div>

<div class="bg-brand-slate rounded-2xl border border-gray-800 overflow-hidden">
    <div class="p-4 border-b border-gray-800 bg-brand-slate/50">
        <form action="/reports/grades" method="GET" class="flex gap-3 max-w-md">
            <select name="course"
                class="flex-1 bg-brand-navy border border-gray-700 rounded-lg px-4 py-2 text-sm text-white">
                <option value="">All Courses</option>
                <% for (const c of courses) { %>
                    <option value="<%= c.id %>" <%=String(courseFilter)===String(c.id) ? 'selected' : '' %>><%=
                            c.course_code %> — <%= c.name %>
                    </option>
                    <% } %>
            </select>
            <button type="submit"
                class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm">Filter</button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-400">
            <thead class="text-xs uppercase bg-brand-navy/50 border-b border-gray-800">
                <tr>
                    <th class="px-4 py-3">Student ID</th>
                    <th class="px-4 py-3">Student</th>
                    <th class="px-4 py-3">Course</th>
                    <th class="px-4 py-3 text-center">Average</th>
                    <th class="px-4 py-3 text-center">Grade</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
                <% if (rows.length===0) { %>
                    <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-gray-500">No grades recorded yet.</td>
                    </tr>
                    <% } else { %>
                        <% for (const r of rows) { %>
                            <tr class="hover:bg-brand-navy/30">
                                <td class="px-4 py-3 font-mono text-brand-cyan text-xs">
                                    <%= r.code %>
                                </td>
                                <td class="px-4 py-3 text-white">
                                    <a href="/exams/report-card/<%= r.student_id %>" class="hover:text-brand-violet">
                                        <%= r.name %>
                                    </a>
                                </td>
                                <td class="px-4 py-3">
                                    <%= r.course %> <span class="text-xs text-brand-cyan font-mono">(<%= r.course_code
                                                %>)</span>
                                </td>
                                <td class="px-4 py-3 text-center text-white font-medium">
                                    <%= r.avg_pct %>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= r.letterClass %>">
                                        <%= r.letter %>
                                    </span>
                                </td>
                            </tr>
                            <% } %>
                                <% } %>
            </tbody>
        </table>
    </div>
</div>